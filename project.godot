; Engine configuration file.
; Castle Scaper -- build a castle the Townscaper way: click to stack blocks on an organic grid, the towers, walls,
; roofs, gates and courtyards come out of what is around each block (Godot 4.7, GDScript).

config_version=5

[application]

config/name="Castle Scaper Hex"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.6, 0.78, 0.86, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
